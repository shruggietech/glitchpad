  "guide": {
    "idea": "View your files.",
    "descriptor": "Text, source code, images, PDFs, and office documents.",
    "foundation_title": "Supported file categories",
    "foundation": "Glitchpad opens common local file formats on desktop and Android. View text, source code, Markdown, raster and vector images, PDFs, DOCX, and ODT files. Edit Markdown, text, and source files where supported.",
    "personality": [
      [
        "Direct",
        "Uses plain labels and short sentences",
        "Metaphor and suspense"
      ],
      [
        "Unobtrusive",
        "Keeps controls compact and file content visually primary",
        "Decorative or attention-seeking UI"
      ],
      [
        "Familiar",
        "Uses predictable controls and layouts",
        "Novel interaction for its own sake"
      ]
    ],
    "promises": [
      "Common file formats open in one app across desktop and Android.",
      "Content, structure, and metadata use familiar navigation.",
      "Markdown, text, and source files can be edited where supported."
    ],
    "in_scope": [
      "Text, source code, Markdown, images, PDFs, DOCX, and ODT",
      "Search, navigation, document metadata, image dimensions, and EXIF",
      "Editing Markdown, text, and source files where supported"
    ],
    "out_of_scope": [
      "Executing file contents",
      "Claiming a file is safe",
      "Replacing a dedicated editor or forensic suite"
    ],
    "sharp_edge": "File contents can be sensitive or malformed. Glitchpad reports what it can read and does not determine whether a file is safe.",
    "logo": "The rectangular paper and G share one protected construction inside a permanent square. On dark surfaces the square is sulfur with a charcoal page; on light surfaces the square is charcoal with a sulfur page. The slate fold stays consistent across both contexts.",
    "palette": "Near-black surfaces keep controls visually secondary to file content. Pure sulfur provides identity, focus, and selection; cool slate supplies the fold and subdued states. Muddy and darkened yellows are prohibited."
  },
