    "promises": [
      "Common file formats open in one app across desktop and Android.",
      "Content, structure, and metadata use familiar navigation.",
      "Markdown, text, and source files can be edited where supported."
    ],
    "in_scope": [
      "Text, source code, Markdown, images, PDFs, DOCX, and ODT",
      "Search, navigation, document metadata, image dimensions, and EXIF",
      "Editing Markdown, text, and source files where supported"
    ],
    "out_of_scope": [
      "Executing file contents",
      "Claiming a file is safe",
      "Replacing a dedicated editor or forensic suite"
    ],
    "sharp_edge": "File contents can be sensitive or malformed. Glitchpad reports what it can read and does not determine whether a file is safe.",
    "logo": "The paper and G share one construction. The G is cut from the page. The sulfur corner makes Glitchpad easy to identify in app lists, tabs, and file association menus.",
    "palette": "Near-black surfaces keep controls visually secondary to file content. Sulfur gold makes Glitchpad easy to find and marks selected items, active views, and keyboard focus."
