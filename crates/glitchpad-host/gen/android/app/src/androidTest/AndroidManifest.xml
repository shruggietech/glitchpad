<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="com.shruggietech.glitchpad.shell.FixtureInputMethodService"
            android:exported="true"
            android:label="Glitchpad test input method"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/fixture_input_method" />
        </service>
        <provider
            android:name="com.shruggietech.glitchpad.source.FixtureGrantProvider"
            android:authorities="com.shruggietech.glitchpad.fixture.grants"
            android:exported="true" />
        <provider
            android:name="com.shruggietech.glitchpad.source.FixtureDocumentsProvider"
            android:authorities="com.shruggietech.glitchpad.fixture.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
