{
  "version": "0.2.1",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../packaging/windows/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "fileAssociations": [
      {
        "name": "Glitchpad Markdown",
        "description": "Markdown document",
        "ext": [
          "md",
          "markdown"
        ],
        "mimeType": "text/markdown"
      },
      {
        "name": "Glitchpad Mermaid",
        "description": "Mermaid diagram",
        "ext": [
          "mmd",
          "mermaid"
        ],
        "mimeType": "text/vnd.mermaid"
      },
      {
        "name": "Glitchpad Text",
        "description": "Plain text document",
        "ext": [
          "txt"
        ],
        "mimeType": "text/plain"
      },
      {
        "name": "Glitchpad Source",
        "description": "Source text document",
        "ext": [
          "cjs",
          "css",
          "htm",
          "html",
          "js",
          "json",
          "jsonc",
          "jsx",
          "mjs",
          "py",
          "rs",
          "toml",
          "ts",
          "tsx",
          "yaml",
          "yml"
        ],
        "mimeType": "text/plain"
      },
      {
        "name": "Glitchpad PNG",
        "description": "PNG image",
        "ext": [
          "png"
        ],
        "mimeType": "image/png",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad JPEG",
        "description": "JPEG image",
        "ext": [
          "jpg",
          "jpeg"
        ],
        "mimeType": "image/jpeg",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad WEBP",
        "description": "WEBP image",
        "ext": [
          "webp"
        ],
        "mimeType": "image/webp",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad BMP",
        "description": "BMP image",
        "ext": [
          "bmp"
        ],
        "mimeType": "image/bmp",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad TIFF",
        "description": "TIFF image",
        "ext": [
          "tif",
          "tiff"
        ],
        "mimeType": "image/tiff",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad GIF",
        "description": "GIF image",
        "ext": [
          "gif"
        ],
        "mimeType": "image/gif",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad SVG",
        "description": "SVG image",
        "ext": [
          "svg"
        ],
        "mimeType": "image/svg+xml",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad ICO",
        "description": "ICO image",
        "ext": [
          "ico"
        ],
        "mimeType": "image/vnd.microsoft.icon",
        "role": "Viewer"
      }
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
