{
  "version": "0.3.1",
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../packaging/macos/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "fileAssociations": [
      {
        "name": "Glitchpad Markdown",
        "description": "Markdown document",
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "name": "Glitchpad Mermaid",
        "description": "Mermaid diagram",
        "ext": ["mmd", "mermaid"],
        "mimeType": "text/vnd.mermaid",
        "role": "Editor"
      },
      {
        "name": "Glitchpad Text",
        "description": "Plain text document",
        "ext": ["txt"],
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "name": "Glitchpad Source",
        "description": "Source text document",
        "ext": [
          "cjs",
          "css",
          "htm",
          "html",
          "js",
          "json",
          "jsonc",
          "jsx",
          "mjs",
          "py",
          "rs",
          "toml",
          "ts",
          "tsx",
          "yaml",
          "yml"
        ],
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "name": "Glitchpad PNG",
        "description": "PNG image",
        "ext": ["png"],
        "mimeType": "image/png",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad JPEG",
        "description": "JPEG image",
        "ext": ["jpg", "jpeg"],
        "mimeType": "image/jpeg",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad WEBP",
        "description": "WEBP image",
        "ext": ["webp"],
        "mimeType": "image/webp",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad BMP",
        "description": "BMP image",
        "ext": ["bmp"],
        "mimeType": "image/bmp",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad TIFF",
        "description": "TIFF image",
        "ext": ["tif", "tiff"],
        "mimeType": "image/tiff",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad GIF",
        "description": "GIF image",
        "ext": ["gif"],
        "mimeType": "image/gif",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad SVG",
        "description": "SVG image",
        "ext": ["svg"],
        "mimeType": "image/svg+xml",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad ICO",
        "description": "ICO image",
        "ext": ["ico"],
        "mimeType": "image/vnd.microsoft.icon",
        "role": "Viewer"
      },
      {
        "name": "Glitchpad PDF",
        "description": "PDF document",
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    }
  }
}
