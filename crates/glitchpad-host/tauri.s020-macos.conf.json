{
  "version": "0.1.0",
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../packaging/macos/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "fileAssociations": [
      {
        "name": "Glitchpad Markdown",
        "description": "Markdown document",
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "name": "Glitchpad Mermaid",
        "description": "Mermaid diagram",
        "ext": ["mmd", "mermaid"],
        "mimeType": "text/vnd.mermaid",
        "role": "Editor"
      },
      {
        "name": "Glitchpad Text",
        "description": "Plain text document",
        "ext": ["txt"],
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "name": "Glitchpad Source",
        "description": "Source text document",
        "ext": [
          "cjs",
          "css",
          "htm",
          "html",
          "js",
          "json",
          "jsonc",
          "jsx",
          "mjs",
          "py",
          "rs",
          "toml",
          "ts",
          "tsx",
          "yaml",
          "yml"
        ],
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    }
  }
}
