{
  "schema_version": 1,
  "release": "0.2.1",
  "families": [
    {
      "id": "markdown",
      "description": "Markdown document",
      "extensions": [
        "md",
        "markdown"
      ],
      "media_types": [
        "text/markdown"
      ],
      "renderer": "markdown",
      "association": true,
      "dialog": true
    },
    {
      "id": "mermaid",
      "description": "Mermaid diagram",
      "extensions": [
        "mmd",
        "mermaid"
      ],
      "media_types": [
        "text/vnd.mermaid"
      ],
      "renderer": "mermaid",
      "association": true,
      "dialog": true
    },
    {
      "id": "plain-text",
      "description": "Plain text document",
      "extensions": [
        "txt"
      ],
      "media_types": [
        "text/plain"
      ],
      "renderer": "text",
      "association": true,
      "dialog": true
    },
    {
      "id": "source",
      "description": "Source text document",
      "extensions": [
        "cjs",
        "css",
        "htm",
        "html",
        "js",
        "json",
        "jsonc",
        "jsx",
        "mjs",
        "py",
        "rs",
        "toml",
        "ts",
        "tsx",
        "yaml",
        "yml"
      ],
      "media_types": [
        "text/plain"
      ],
      "renderer": "source",
      "association": true,
      "dialog": true
    },
    {
      "id": "png",
      "description": "PNG image",
      "extensions": [
        "png"
      ],
      "media_types": [
        "image/png"
      ],
      "renderer": "image",
      "association": true,
      "dialog": true
    },
    {
      "id": "jpeg",
      "description": "JPEG image",
      "extensions": [
        "jpg",
        "jpeg"
      ],
      "media_types": [
        "image/jpeg"
      ],
      "renderer": "image",
      "association": true,
      "dialog": true
    },
    {
      "id": "webp",
      "description": "WEBP image",
      "extensions": [
        "webp"
      ],
      "media_types": [
        "image/webp"
      ],
      "renderer": "image",
      "association": true,
      "dialog": true
    },
    {
      "id": "bmp",
      "description": "BMP image",
      "extensions": [
        "bmp"
      ],
      "media_types": [
        "image/bmp"
      ],
      "renderer": "image",
      "association": true,
      "dialog": true
    },
    {
      "id": "tiff",
      "description": "TIFF image",
      "extensions": [
        "tif",
        "tiff"
      ],
      "media_types": [
        "image/tiff"
      ],
      "renderer": "image",
      "association": true,
      "dialog": true
    },
    {
      "id": "gif",
      "description": "GIF image",
      "extensions": [
        "gif"
      ],
      "media_types": [
        "image/gif"
      ],
      "renderer": "image",
      "association": true,
      "dialog": true
    },
    {
      "id": "svg",
      "description": "SVG image",
      "extensions": [
        "svg"
      ],
      "media_types": [
        "image/svg+xml"
      ],
      "renderer": "image",
      "association": true,
      "dialog": true
    },
    {
      "id": "ico",
      "description": "ICO image",
      "extensions": [
        "ico"
      ],
      "media_types": [
        "image/vnd.microsoft.icon",
        "image/x-icon"
      ],
      "renderer": "image",
      "association": true,
      "dialog": true
    },
    {
      "id": "pdf",
      "description": "PDF document",
      "extensions": [
        "pdf"
      ],
      "media_types": [
        "application/pdf"
      ],
      "renderer": "pdf",
      "association": true,
      "dialog": true
    }
  ],
  "forbidden_extensions": [
    "7z",
    "aab",
    "apk",
    "dll",
    "docx",
    "exe",
    "msi",
    "odp",
    "ods",
    "odt",
    "pptx",
    "rar",
    "xlsx",
    "zip"
  ]
}
