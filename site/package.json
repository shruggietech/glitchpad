{
  "name": "@shruggietech/glitchpad-site",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prebuild.mjs && next dev",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "next build && node scripts/postbuild.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "pnpm build && pnpm test:unit && pnpm test:browser"
  },
  "dependencies": {
    "fumadocs-core": "16.17.7",
    "fumadocs-ui": "16.17.7",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fumadocs-mdx": "15.4.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
